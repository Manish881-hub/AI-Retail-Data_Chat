# --- LLM (optional: no paid service is required; with LLM_PROVIDER=none a deterministic rule planner is used) ---
LLM_PROVIDER=none            # none | openai | anthropic   ("openai" = any OpenAI-compatible endpoint)
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
LLM_BACKOFF_S=0.5

# --- App ---
DATA_DIR=./data_store
MAX_UPLOAD_MB=25
MAX_ROWS=1000000
QUERY_TIMEOUT_S=10
DATE_DAYFIRST=false          # tie-break ONLY when a date column has no day>12 / month>12 evidence
API_TOKEN=                   # if set, requests need "Authorization: Bearer <token>"
